From 7e28715a0f7da19ed212e6aec627df90620e494c Mon Sep 17 00:00:00 2001
From: Claude <bot@local>
Date: Sun, 23 Aug 2026 19:23:12 +0000
Subject: [PATCH] Move service/user image uploads to Supabase Storage

- utils/supabaseStorage.js: service-role client + uploadImage() helper
- serviceController/userController: resize with sharp into a buffer, upload to the
  service-images/user-images buckets instead of writing to public/images/... on
  local disk (which doesn't persist on Vercel's serverless filesystem)
- migration: creates both buckets (public) with public-read storage policies;
  uploads go through the service-role key so they bypass RLS
- imageGetter.js: /api/image/... routes now redirect to the stored Supabase URL
  instead of streaming a file off disk
- package.json: add @supabase/supabase-js
- config.env.example: SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are now required
  (anon key isn't used server-side, dropped from the example)
---
 api/config.env.example                        |   5 +-
 api/controllers/serviceController.js          |  19 +-
 api/controllers/userController.js             |   9 +-
 api/package-lock.json                         | 480 +++++++++---------
 api/package.json                              |   1 +
 api/utils/imageGetter.js                      |  39 +-
 api/utils/supabaseStorage.js                  |  27 +
 .../20260823010000_storage_buckets.sql        |  20 +
 8 files changed, 325 insertions(+), 275 deletions(-)
 create mode 100644 api/utils/supabaseStorage.js
 create mode 100644 supabase/migrations/20260823010000_storage_buckets.sql

diff --git a/api/config.env.example b/api/config.env.example
index 01179a8..b9d552b 100644
--- a/api/config.env.example
+++ b/api/config.env.example
@@ -7,10 +7,9 @@ FRONTEND_URL=https://yourdomain.com
 # Supabase — session pooler (IPv4, port 5432; required for Vercel's serverless functions)
 DATABASE_URL=postgresql://postgres.xmtrpirnditotpyhqiwk:<db-password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
 
-# Only needed if/when Storage or Supabase Auth get wired in — the API's day-to-day
-# queries go straight over DATABASE_URL above.
+# Supabase Storage — used for service/user image uploads (SUPABASE_ANON_KEY isn't
+# used server-side; only needed if the frontend talks to Supabase directly).
 SUPABASE_URL=https://xmtrpirnditotpyhqiwk.supabase.co
-SUPABASE_ANON_KEY=
 SUPABASE_SERVICE_ROLE_KEY=
 
 JWT_SECRET=
diff --git a/api/controllers/serviceController.js b/api/controllers/serviceController.js
index 3d6e2bf..ddda7e7 100644
--- a/api/controllers/serviceController.js
+++ b/api/controllers/serviceController.js
@@ -3,6 +3,7 @@ const AppError = require("../utils/AppError");
 const catchAsync = require("../utils/catchAsync");
 const upload = require("./../utils/multerConfig");
 const sharp = require("sharp");
+const { uploadImage } = require("../utils/supabaseStorage");
 
 exports.getTopRatedService = catchAsync(async (req, res, next) => {
     const found = await Services.findTopRated();
@@ -18,17 +19,15 @@ exports.uploadServiceImage = upload.single("image");
 
 exports.resizeServiceImage = catchAsync(async (req, res, next) => {
     if (!req.file) return next();
-    req.file.fileName = `service-${req.body.name}-${Date.now()}.jpeg`;
+    const fileName = `service-${req.body.name}-${Date.now()}.jpeg`;
 
-    try {
-        await sharp(req.file.buffer)
-            .resize(2000, 1333)
-            .toFormat("jpeg")
-            .jpeg({ quality: 90 })
-            .toFile(`public/images/services/${req.file.fileName}`);
-    } catch (error) {
-        console.log(error);
-    }
+    const buffer = await sharp(req.file.buffer)
+        .resize(2000, 1333)
+        .toFormat("jpeg")
+        .jpeg({ quality: 90 })
+        .toBuffer();
+
+    req.body.image = await uploadImage('service-images', fileName, buffer);
     next();
 });
 
diff --git a/api/controllers/userController.js b/api/controllers/userController.js
index a2c029d..2dfeeb7 100644
--- a/api/controllers/userController.js
+++ b/api/controllers/userController.js
@@ -2,19 +2,22 @@ const Users = require("../models/userModel");
 const catchAsync = require("./../utils/catchAsync");
 const upload = require("./../utils/multerConfig");
 const sharp = require("sharp");
+const { uploadImage } = require("../utils/supabaseStorage");
 
 exports.uploadUserImage = upload.single("image");
 
 exports.resizeUserImage = catchAsync(async (req, res, next) => {
   if (!req.file) return next();
 
-  req.file.fileName = `user-${req.user.id}-${Date.now()}.jpeg`;
+  const fileName = `user-${req.user.id}-${Date.now()}.jpeg`;
 
-  await sharp(req.file.buffer)
+  const buffer = await sharp(req.file.buffer)
     .resize(500, 500)
     .toFormat("jpeg")
     .jpeg({ quality: 90 })
-    .toFile(`public/images/users/${req.file.fileName}`);
+    .toBuffer();
+
+  req.file.fileName = await uploadImage('user-images', fileName, buffer);
   next();
 });
 
