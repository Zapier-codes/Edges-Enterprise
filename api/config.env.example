# Copy to config.env locally (never commit the real file — it's gitignored).
# In Vercel: Project Settings → Environment Variables. In GitHub Actions: repo Secrets.

NODE_ENV=production
FRONTEND_URL=https://yourdomain.com

# Supabase — session pooler (IPv4, port 5432; required for Vercel's serverless functions)
DATABASE_URL=postgresql://postgres.xmtrpirnditotpyhqiwk:<db-password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Only needed if/when Storage or Supabase Auth get wired in — the API's day-to-day
# queries go straight over DATABASE_URL above.
SUPABASE_URL=https://xmtrpirnditotpyhqiwk.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
JWT_EXPIRY=90d
JWT_COOKIE_EXPIRY=90
