From 708cbb5499f462e9b6fac70fc911fc25c1f2ba99 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Sun, 23 Aug 2026 19:40:57 +0000
Subject: [PATCH] Fix 404 on root domain: unify frontend + api into single
 Vercel deployment

The Vercel project's Root Directory was pointed at api/, so the
production domain only ever served the bare Express app, which has
no route for '/' and correctly 404s via its catch-all handler.

Add a root-level vercel.json that builds the CRA frontend as the
static site and the Express API as a serverless function under
/api/*, and remove the now-redundant per-folder vercel.json files.

NOTE: this also requires clearing the 'Root Directory' project
setting in the Vercel dashboard (Settings -> General -> Root
Directory) back to blank/repo-root, since that setting lives in
Vercel's project config, not in git.
---
 api/vercel.json      | 26 --------------------------
 frontend/vercel.json |  8 --------
 vercel.json          | 37 +++++++++++++++++++++++++++++++++++++
 3 files changed, 37 insertions(+), 34 deletions(-)
 delete mode 100644 api/vercel.json
 delete mode 100644 frontend/vercel.json
 create mode 100644 vercel.json

diff --git a/api/vercel.json b/api/vercel.json
deleted file mode 100644
index 4338045..0000000
--- a/api/vercel.json
+++ /dev/null
@@ -1,26 +0,0 @@
-{
-    "version": 2,
-    "builds": [
-        {
-            "src": "server.js",
-            "use": "@vercel/node"
-        }
-    ],
-    "routes": [
-        {
-            "src": "/(.*)",
-            "dest": "server.js",
-            "methods": [
-                "GET",
-                "POST",
-                "PUT",
-                "DELETE",
-                "PATCH",
-                "OPTIONS"
-            ],
-            "headers": {
-                "Access-Control-Allow-Origin": "*"
-            }
-        }
-    ]
-}
\ No newline at end of file
diff --git a/frontend/vercel.json b/frontend/vercel.json
deleted file mode 100644
index 998278c..0000000
--- a/frontend/vercel.json
+++ /dev/null
@@ -1,8 +0,0 @@
-{
-    "rewrites": [
-        {
-            "source": "/(.*)",
-            "destination": "/"
-        }
-    ]
-}
\ No newline at end of file
diff --git a/vercel.json b/vercel.json
new file mode 100644
index 0000000..822d39b
--- /dev/null
+++ b/vercel.json
@@ -0,0 +1,37 @@
+{
+    "version": 2,
+    "builds": [
+        {
+            "src": "frontend/package.json",
+            "use": "@vercel/static-build",
+            "config": {
+                "distDir": "build"
+            }
+        },
+        {
+            "src": "api/server.js",
+            "use": "@vercel/node"
+        }
+    ],
+    "routes": [
+        {
+            "src": "/api/(.*)",
+            "dest": "api/server.js",
+            "headers": {
+                "Access-Control-Allow-Origin": "*"
+            }
+        },
+        {
+            "src": "/static/(.*)",
+            "dest": "frontend/static/$1"
+        },
+        {
+            "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|svg|json|txt|map|webmanifest))",
+            "dest": "frontend/$1"
+        },
+        {
+            "src": "/(.*)",
+            "dest": "frontend/index.html"
+        }
+    ]
+}
-- 
2.43.0

